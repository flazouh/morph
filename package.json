  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.111",
    "effect": "4.0.0-rc.111"
  },
  "scripts": {
    "build": "wxt build && bun test scripts/extension-build-contract.test.ts",
    "build:web": "vite build",
    "build:marketplace-web": "vite build --mode marketplace",
    "start:marketplace-api": "bun run src/marketplace/api/server.ts",
    "zip": "wxt zip",
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "dev:design-system": "vite --mode design-system --open /design-system.html",
    "sandbox:host": "bun run build:web && bunx vite preview --open /sandbox-host.html",
    "relay": "bun src/relay/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:effect": "bun scripts/lint-effect.ts",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test": "bun run lint:effect && bun run test:panel && bun run test:marketplace && bun run test:core && bun run test:relay && bun run test:build",
    "test:build": "wxt build && bun test scripts/extension-build-contract.test.ts",
    "test:relay": "bun test src/relay",
    "test:panel": "bun test --preload ./src/panel/test-setup.ts src/panel src/kit src/overlay src/bridge/loader.test.ts src/content.test.ts",
    "test:marketplace": "bun test --preload ./src/panel/test-setup.ts src/marketplace",
    "test:core": "bun test src/agent src/background.test.ts src/bridge/dom.test.ts src/bridge/user-scripts.test.ts src/bridge/web.test.ts src/bridge/web-page.test.ts src/cursor src/session src/skin src/inspector src/lib"
  },
  "patchedDependencies": {
    "@clavia/tardigrade@0.0.1": "patches/@clavia%2Ftardigrade@0.0.1.patch"
  }
