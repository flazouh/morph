    "@hugeicons/react": "^1.1.10",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@paper-design/shaders-react": "0.0.80",
    "@primer/octicons-react": "^19.33.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
