#!/bin/sh
# The Effect v4 style gate and the typecheck run before every commit. `bun install` sets
# core.hooksPath to this folder (the `prepare` script). Skip once with `git commit --no-verify`
# only when the commit is a `wip:` you will fix before review.
set -e
cd "$(git rev-parse --show-toplevel)"
bun run lint:effect
bun run typecheck
